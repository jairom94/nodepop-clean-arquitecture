# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Etapa 1: dependencias. Aquí viven el compilador y pnpm; no llegan a la imagen final.
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS deps

WORKDIR /usr/src/app

# Toolchain para módulos nativos (bcrypt, better-sqlite3) si no hay binario precompilado
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@10.32.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# El almacén de pnpm va en una caché de BuildKit: acelera reconstrucciones y no pesa en la imagen
RUN --mount=type=cache,id=nodepop-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

# ---------------------------------------------------------------------------
# Etapa 2: imagen de desarrollo. Solo Node, node_modules ya compilado y el código.
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS dev

ENV CI=true

WORKDIR /usr/src/app

# Usuario sin privilegios (uid 1000): lo que escribe en volúmenes montados no queda como root
COPY --from=deps --chown=node:node /usr/src/app/node_modules ./node_modules
COPY --chown=node:node . .

USER node

EXPOSE 3005

# La imagen slim no trae curl: se comprueba con fetch de Node
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3005/health').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"

# tsx directamente: la imagen final no necesita pnpm
CMD ["node_modules/.bin/tsx", "watch", "src/index.ts"]
