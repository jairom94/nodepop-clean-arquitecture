# Copia este archivo a .env y rellena los valores.

DATABASE_URL="file:./nodepop.sqlite"

# Secretos JWT: al menos 32 caracteres aleatorios y distintos entre sí.
# Genera cada uno con: openssl rand -base64 48
JWT_SECRET=""
JWT_REFRESH_SECRET=""

JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

MODE="development"
CORS_ORIGIN="http://localhost:5173"

# Demo pública de solo lectura: "true" bloquea registros y escrituras
DEMO_MODE="false"
